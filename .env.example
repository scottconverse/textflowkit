# Template for the Compose example. Copy it to `.env`, which is git-ignored:
#
#   cp .env.example .env
#
# There is no default token, and Compose will not start without one. Generate a
# value and paste it in:
#
#   openssl rand -hex 32
#
# A token reaches the server as its own environment variable, never as a command
# line argument, so it stays out of `ps` and out of the container's inspect data.
# Keep it out of the repository and out of any image layer.

TEXTFLOWKIT_API_TOKEN=
